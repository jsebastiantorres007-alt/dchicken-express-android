.check-btn.on{background:var(--tint);box-shadow:none;color:var(--on-tint);font-size:15px;font-weight:700}
.shopping-item.sel .shopping-info b{font-weight:600}
.shop-groupbar{position:sticky;bottom:16px;z-index:46;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding:10px 10px 10px 16px;border-radius:999px;background:var(--chrome);backdrop-filter:blur(22px) saturate(180%);-webkit-backdrop-filter:blur(22px) saturate(180%);box-shadow:var(--shadow-float),0 0 0 .5px var(--sep);animation:fade .25s var(--ease-out) both}
