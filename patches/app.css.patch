/* v17: registros que no se guardaron, historial de cambios */
.fail-list{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:8px}
.fail-item{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:10px 12px;border-radius:12px;background:var(--fill)}
.fail-item div{display:grid;gap:2px;min-width:0}
.fail-item small{color:var(--bad-ink);font-size:13px;line-height:1.35}
.fail-item .btn{flex:none}
tr.late td{background:color-mix(in oklch,var(--bad-soft) 55%,transparent)}
.audit-list{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:8px}
.audit-item{padding:11px 13px;border-radius:12px;background:var(--fill);display:grid;gap:3px}
.audit-item.late{background:color-mix(in oklch,var(--bad-soft) 70%,var(--fill))}
.audit-head{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.audit-meta{font-size:13px;color:var(--ink-2,var(--muted))}
.audit-detail{font-size:13.5px;line-height:1.45;font-variant-numeric:tabular-nums}
